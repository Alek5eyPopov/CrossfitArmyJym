<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:background="@color/divider" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="108dp"
        android:background="@drawable/bg_schedule_row_card"
        android:paddingStart="0dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <View
            android:id="@+id/accent_bar"
            android:layout_width="5dp"
            android:layout_height="76dp"
            android:background="@color/army_red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/time_box"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/accent_bar"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_class_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                tools:text="18:00" />

            <TextView
                android:id="@+id/tv_class_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_hint"
                android:textSize="14sp"
                tools:text="55 мин." />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_class_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.02"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_chevron"
            app:layout_constraintStart_toEndOf="@id/time_box"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="CROSSFIT" />

        <TextView
            android:id="@+id/tv_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/tv_chevron"
            app:layout_constraintStart_toStartOf="@id/tv_class_name"
            app:layout_constraintTop_toBottomOf="@id/tv_class_name"
            tools:text="Основной зал" />

        <TextView
            android:id="@+id/tv_available_slots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tv_chevron"
            app:layout_constraintStart_toStartOf="@id/tv_class_name"
            app:layout_constraintTop_toBottomOf="@id/tv_location"
            tools:text="Осталось мест: 10" />

        <TextView
            android:id="@+id/tv_booked_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_schedule_booked_badge"
            android:text="@string/booking_active"
            android:textColor="@color/text_on_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tv_class_name"
            app:layout_constraintTop_toBottomOf="@id/tv_available_slots" />

        <TextView
            android:id="@+id/tv_chevron"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/text_hint"
            android:textSize="40sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_book"
            style="@style/Widget.CrossfitArmyJym.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/book"
            android:textSize="10sp"
            app:cornerRadius="7dp"
            app:layout_constraintStart_toStartOf="@id/tv_class_name"
            app:layout_constraintTop_toBottomOf="@id/tv_available_slots" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
