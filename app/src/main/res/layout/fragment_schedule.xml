<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="132dp"
        android:background="@drawable/bg_army_screen_header"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            style="@style/Widget.CrossfitArmyJym.ScreenTitle.OnDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedule_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/schedule_subtitle"
            android:textColor="#B8C7CE"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_panel"
        android:layout_width="0dp"
        android:layout_height="132dp"
        android:background="@color/surface"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            android:id="@+id/tv_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:textColor="@color/army_navy"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="ИЮЛЬ 2026" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_prev_week"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/schedule_prev_week"
                android:textColor="@color/text_hint"
                android:textSize="34sp" />

            <LinearLayout
                android:id="@+id/date_tabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/btn_next_week"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/schedule_next_week"
                android:textColor="@color/text_hint"
                android:textSize="34sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_schedule"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calendar_panel"
        tools:listitem="@layout/item_schedule_class" />

    <TextView
        android:id="@+id/btn_refresh"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_schedule_filter"
        android:gravity="center"
        android:text="@string/refresh_short"
        android:textColor="@color/army_navy"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/header" />

    <LinearLayout
        android:id="@+id/empty_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calendar_panel">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/schedule_empty_title"
            android:src="@drawable/army_emblem_white"
            app:tint="@color/army_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/schedule_empty_title"
            android:textColor="@color/army_navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/schedule_empty_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:indeterminateTint="@color/army_red"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calendar_panel" />

</androidx.constraintlayout.widget.ConstraintLayout>
